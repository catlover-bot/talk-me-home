  "subtitles": [
    {
      "start": 0.4477416666666665,
      "end": 5.976116666666665,
      "text": "Pip: Mission Control, this is Pip. Can you hear me? I need\nyour help getting out."
    },
    {
      "start": 14.141033333333333,
      "end": 17.748199999999997,
      "text": "Player (synthetic): My diagram says the door and conveyor share one power\nsupply."
    },
    {
      "start": 20.620449999999998,
      "end": 23.693638144329896,
      "text": "Pip: I have proposed to engage the latch. Please confirm"
    },
    {
      "start": 23.693638144329896,
      "end": 26.465533333333333,
      "text": "Pip: this action on the console when you are ready."
    },
    {
      "start": 27.987241666666662,
      "end": 31.447283333333345,
      "text": "Pip: The latch is engaged and the door is being held open."
    },
    {
      "start": 33.00057500000001,
      "end": 34.12740833333335,
      "text": "Player (synthetic): Power is now off."
    },
    {
      "start": 35.80474166666667,
      "end": 38.60911625412541,
      "text": "Pip: The conveyor stopped moving when the power went out."
    },
    {
      "start": 38.60911625412541,
      "end": 41.2517,
      "text": "Pip: Should I try moving to the far side platform now?"
    },
    {
      "start": 43.43511666666667,
      "end": 45.034283333333335,
      "text": "Player (synthetic): Please cross to the far side."
    },
    {
      "start": 47.223325,
      "end": 52.12499166666667,
      "text": "Pip: I have proposed to move to the far side platform.\nPlease confirm this on the console."
    },
    {
      "start": 54.428241666666665,
      "end": 58.10360671091446,
      "text": "Pip: I have arrived at the Ring emblem. The gate to the\neast is"
    },
    {
      "start": 58.10360671091446,
      "end": 61.588866666666675,
      "text": "Pip: closed and unpowered. Do you want me to check the\ngate?"
    },
    {
      "start": 63.283075,
      "end": 66.80869999999999,
      "text": "Player (synthetic): Please inspect the southeast gate and tell me whether\nanything blocks it."
    },
    {
      "start": 71.51182499999999,
      "end": 74.69474166666669,
      "text": "Pip: The southeast gate is open, but there is cargo\nblocking"
    },
    {
      "start": 74.69474166666669,
      "end": 77.87765833333339,
      "text": "Pip: the opening. Should I check the southwest gate\ninstead?"
    },
    {
      "start": 82.06078333333335,
      "end": 85.6277833333333,
      "text": "Player (synthetic): Please inspect the southwest gate and tell me whether\nanything blocks it."
    },
    {
      "start": 91.22340833333334,
      "end": 96.97457499999996,
      "text": "Pip: The southwest gate is open and the passage is clear\nof any cargo. Should I move through it?"
    },
    {
      "start": 98.2971583333333,
      "end": 100.16661666666664,
      "text": "Player (synthetic): Please go through the southwest gate."
    },
    {
      "start": 105.76390833333335,
      "end": 108.58673809523805,
      "text": "Pip: I have proposed to move through the southwest gate."
    },
    {
      "start": 108.58673809523805,
      "end": 111.57561666666663,
      "text": "Pip: Please confirm this on the console when you are\nready."
    },
    {
      "start": 115.18461666666667,
      "end": 119.50804302325582,
      "text": "Pip: I have arrived at the Fork emblem. The northeast gate\nis open, but"
    },
    {
      "start": 119.50804302325582,
      "end": 123.63495,
      "text": "Pip: the west and southeast gates are closed. Which way\nshould I go?"
    },
    {
      "start": 125.31290833333327,
      "end": 126.71532499999995,
      "text": "Player (synthetic): Please hold the contact."
    },
    {
      "start": 131.0367833333333,
      "end": 133.5872974842767,
      "text": "Pip: I have proposed to hold the charging contact. Please"
    },
    {
      "start": 133.5872974842767,
      "end": 136.23590833333327,
      "text": "Pip: confirm this action on the console when you are\nready."
    },
    {
      "start": 141.25790833333332,
      "end": 143.14878333333326,
      "text": "Pip: I am holding the contact steadily."
    },
    {
      "start": 148.45290833333326,
      "end": 152.92124166666662,
      "text": "Pip: I have boarded the recovery capsule, and the return\npanel is within reach."
    },
    {
      "start": 154.17415833333337,
      "end": 158.00290833333327,
      "text": "Player (synthetic): Please propose confirming the return with the\ninspected capsule operation."
    },
    {
      "start": 162.6512416666667,
      "end": 165.9558404867256,
      "text": "Pip: I have proposed to confirm the authorized return.\nPlease"
    },
    {
      "start": 165.9558404867256,
      "end": 169.31944999999996,
      "text": "Pip: confirm this action on the console to finish the\nprocess."
    },
    {
      "start": 173.9571166666667,
      "end": 177.77761666666663,
      "text": "Pip: The return is confirmed and the capsule has brought\nme home."
    }
