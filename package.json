{
  "name": "talk-me-home",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "A voice-led cooperative rescue: you hold the map, Pip sees the station.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "npm run start:game",
    "publish": "node publish.mjs",
    "import": "node import.mjs",
    "phone": "node deployment/telephony/connect.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && vite build",
    "build:game": "npm run build && tsc -p tsconfig.server.json && node scripts/write-release-identity.mjs",
    "start:game": "node dist/server/server/production.js",
    "game:allowance": "node scripts/initialize-allowance.mjs",
    "game": "tsx game/server/index.ts",
    "test:live": "tsx scripts/live-check.ts",
    "qa:release": "node scripts/qa-release.mjs",
    "qa:speech": "node scripts/qa-speech-fixtures.mjs",
    "qa:live": "node scripts/qa-live-browser.mjs",
    "start:starter": "node deployment/browser/server.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
